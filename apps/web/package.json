    "clsx": "2.1.1",
    "input-otp": "^1.4.2",
    "isbot": "5.2.1",
    "lucide-react": "1.28.0",
    "openapi-fetch": "0.17.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "react-router": "8.3.0",
