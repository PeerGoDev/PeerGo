{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peergo.dev/contracts/snapshots/tracker-control/v1/payload.schema.json",
  "title": "PeerGo Tracker control snapshot payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "control_sequence",
    "state_sha256",
    "torrents"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "control_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "torrents": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/torrent" }
    }
  },
  "$defs": {
    "torrent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "torrent_id",
        "torrent_public_id",
        "info_hash_v1",
        "total_size_bytes",
        "torrent_version",
        "control_sequence"
      ],
      "properties": {
        "torrent_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "torrent_public_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "info_hash_v1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "torrent_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "control_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    }
  }
}
