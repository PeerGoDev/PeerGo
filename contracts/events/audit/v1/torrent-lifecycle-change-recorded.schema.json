{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.peergo.invalid/events/audit/v1/torrent-lifecycle-change-recorded.schema.json",
  "title": "Torrent lifecycle change recorded v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "occurred_at",
    "change_id",
    "torrent_id",
    "action",
    "reason_sha256",
    "actor_pseudonym",
    "pseudonym_key_epoch",
    "expected_version",
    "resulting_version",
    "before_sha256",
    "after_sha256",
    "authorization_decision_id",
    "policy_version",
    "authority"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event_type": { "const": "torrents.torrent-lifecycle-change.recorded" },
    "event_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "change_id": { "type": "string", "format": "uuid" },
    "torrent_id": { "type": "integer", "minimum": 1 },
    "action": { "enum": ["disable", "restore"] },
    "reason_sha256": { "type": "string", "pattern": "^sha256_[0-9a-f]{64}$" },
    "actor_pseudonym": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "pseudonym_key_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "expected_version": { "type": "integer", "minimum": 1 },
    "resulting_version": { "type": "integer", "minimum": 2 },
    "before_sha256": { "type": "string", "pattern": "^sha256_[0-9a-f]{64}$" },
    "after_sha256": { "type": "string", "pattern": "^sha256_[0-9a-f]{64}$" },
    "authorization_decision_id": { "type": "string", "format": "uuid" },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "grant_id", "grant_version", "mandate_id", "effective_until"],
      "properties": {
        "role_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "grant_id": { "type": "string", "format": "uuid" },
        "grant_version": { "type": "integer", "minimum": 1 },
        "mandate_id": { "type": "string", "format": "uuid" },
        "effective_until": { "type": "string", "format": "date-time" }
      }
    }
  }
}
