{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.peergo.invalid/events/audit/v1/staff-credential-bootstrap-recorded.schema.json",
  "title": "Staff credential bootstrap recorded v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "occurred_at",
    "ticket_id",
    "transition",
    "target_pseudonym",
    "pseudonym_key_epoch",
    "operator_reference_sha256",
    "ticket_expires_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event_type": { "const": "identity.staff-credential-bootstrap.recorded" },
    "event_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "ticket_id": { "type": "string", "format": "uuid" },
    "transition": { "enum": ["ticket_issued", "credential_enrolled"] },
    "target_pseudonym": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "pseudonym_key_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "operator_reference_sha256": { "type": "string", "pattern": "^sha256_[0-9a-f]{64}$" },
    "ticket_expires_at": { "type": "string", "format": "date-time" },
    "challenge_id": { "type": "string", "format": "uuid" },
    "credential_id_sha256": { "type": "string", "pattern": "^sha256_[0-9a-f]{64}$" },
    "label_sha256": { "type": "string", "pattern": "^sha256_[0-9a-f]{64}$" },
    "decision_id": { "type": "string", "format": "uuid" },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "grant_id", "grant_version", "mandate_id", "effective_until"],
      "properties": {
        "role_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "grant_id": { "type": "string", "format": "uuid" },
        "grant_version": { "type": "integer", "minimum": 1 },
        "mandate_id": { "type": "string", "format": "uuid" },
        "effective_until": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "transition": { "const": "credential_enrolled" } },
        "required": ["transition"]
      },
      "then": {
        "required": [
          "challenge_id",
          "credential_id_sha256",
          "label_sha256",
          "decision_id",
          "policy_version",
          "authority"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["challenge_id"] },
            { "required": ["credential_id_sha256"] },
            { "required": ["label_sha256"] },
            { "required": ["decision_id"] },
            { "required": ["policy_version"] },
            { "required": ["authority"] }
          ]
        }
      }
    }
  ]
}
