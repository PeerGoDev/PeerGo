{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.peergo.invalid/events/audit/v1/promotion-campaign-recorded.schema.json",
  "title": "Promotion campaign recorded v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_type", "event_id", "occurred_at",
    "campaign_id", "scope", "promotion", "starts_at", "ends_at",
    "override_lower_scopes", "reason_sha256", "actor_pseudonym",
    "pseudonym_key_epoch", "decision_id", "policy_version", "authority"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event_type": { "const": "promotion.campaign.recorded" },
    "event_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "campaign_id": { "type": "string", "format": "uuid" },
    "scope": { "enum": ["global", "torrent"] },
    "torrent_id": { "type": "integer", "minimum": 1 },
    "promotion": {
      "enum": [
        "free", "double_upload", "double_upload_free", "half_download",
        "double_upload_half_download", "thirty_percent_download"
      ]
    },
    "starts_at": { "type": "string", "format": "date-time" },
    "ends_at": { "type": "string", "format": "date-time" },
    "override_lower_scopes": { "type": "boolean" },
    "reason_sha256": { "type": "string", "pattern": "^sha256_[0-9a-f]{64}$" },
    "actor_pseudonym": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "pseudonym_key_epoch": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "decision_id": { "type": "string", "format": "uuid" },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "grant_id", "grant_version", "mandate_id", "effective_until"],
      "properties": {
        "role_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "grant_id": { "type": "string", "format": "uuid" },
        "grant_version": { "type": "integer", "minimum": 1 },
        "mandate_id": { "type": "string", "format": "uuid" },
        "effective_until": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "global" } } },
      "then": {
        "not": { "required": ["torrent_id"] },
        "properties": { "override_lower_scopes": { "const": true } }
      }
    },
    {
      "if": { "properties": { "scope": { "const": "torrent" } } },
      "then": {
        "required": ["torrent_id"],
        "properties": { "override_lower_scopes": { "const": false } }
      }
    }
  ]
}
