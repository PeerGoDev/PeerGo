{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.peergo.invalid/events/audit/v1/registration-completed.schema.json",
  "title": "Registration completed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "occurred_at",
    "registration_id",
    "user_pseudonym",
    "pseudonym_key_epoch",
    "admission_mode"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event_type": { "const": "identity.registration.completed" },
    "event_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "registration_id": { "type": "string", "format": "uuid" },
    "user_pseudonym": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "pseudonym_key_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "admission_mode": { "enum": ["open", "invite"] },
    "invitation_id": { "type": "string", "format": "uuid" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "admission_mode": { "const": "invite" } },
        "required": ["admission_mode"]
      },
      "then": { "required": ["invitation_id"] },
      "else": { "not": { "required": ["invitation_id"] } }
    }
  ]
}
