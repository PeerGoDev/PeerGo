{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.peergo.invalid/events/tracker-control/v1/torrent-eligibility-changed.schema.json",
  "title": "Tracker torrent eligibility changed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "occurred_at",
    "torrent_id",
    "torrent_public_id",
    "info_hash_v1",
    "total_size_bytes",
    "enabled",
    "torrent_version"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event_type": { "const": "tracker.torrent-eligibility.changed" },
    "event_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "torrent_id": { "type": "integer", "minimum": 1 },
    "torrent_public_id": { "type": "string", "format": "uuid" },
    "info_hash_v1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "total_size_bytes": { "type": "integer", "minimum": 1 },
    "enabled": { "type": "boolean" },
    "torrent_version": { "type": "integer", "minimum": 1 }
  }
}
