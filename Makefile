# Site administrators use their existing account login. These commands are
# idempotent and never infer authority from a legacy user level or user ID.
admin:
	PEERGO_CORE_DATABASE_URL="$(CORE_DATABASE_URL)" \
	go run ./services/core/cmd/admin --username "$(USERNAME)"

admin-revoke:
	PEERGO_CORE_DATABASE_URL="$(CORE_DATABASE_URL)" \
	go run ./services/core/cmd/admin --username "$(USERNAME)" --revoke

# USERNAME and OPERATOR_REFERENCE are intentionally required at invocation.
# The command prints the raw ticket once; PostgreSQL and audit store hashes.
staff-bootstrap:
	PEERGO_ENV=development \
	PEERGO_CORE_DATABASE_URL="$(CORE_DATABASE_URL)" \
	PEERGO_AUDIT_PSEUDONYM_KEY="$(LOCAL_AUDIT_PSEUDONYM_KEY)" \
	PEERGO_AUDIT_PSEUDONYM_KEY_EPOCH="$(LOCAL_AUDIT_PSEUDONYM_KEY_EPOCH)" \
	go run ./services/core/cmd/staff-bootstrap \
		--username "$(USERNAME)" \
		--operator-reference "$(OPERATOR_REFERENCE)"

compose-up:
	docker compose -f deploy/compose/compose.yaml up -d --wait
	$(MAKE) dev-tracker-stream
	$(MAKE) dev-tracker-swarm-stream
	$(MAKE) dev-settlement-consumer
	$(MAKE) dev-settlement-seeding-snapshot-consumer
	$(MAKE) dev-settlement-traffic-stream
	$(MAKE) dev-settlement-seeding-evidence-stream
	$(MAKE) dev-settlement-hnr-stream
	$(MAKE) dev-core-traffic-consumer
	$(MAKE) dev-core-seeding-evidence-consumer
	$(MAKE) dev-core-hnr-consumer
	$(MAKE) dev-core-swarm-consumers

compose-down:
	docker compose -f deploy/compose/compose.yaml down

# Production orchestration intentionally uses an untracked environment file.
# The wrapper keeps cluster as the default and selects the private single-host
# overlay only when PEERGO_DEPLOYMENT_MODE=single-server is explicit.
production-config:
	./scripts/production-compose.sh config --quiet

production-ready: production-config
	./scripts/validate-production-env.sh

production-build: production-config
	# Every Go process uses the same runtime image. Building one representative
	# service avoids Docker Compose 5 exporting that tag concurrently per service.
	./scripts/production-compose.sh build core-api web

production-up: production-ready production-build
	./scripts/production-compose.sh up -d --wait

production-down: production-config
	./scripts/production-compose.sh down

production-status: production-config
	./scripts/production-compose.sh ps

# Run only after the administrator has reviewed registration, newcomer,
# promotion and H&R policies, and sent a real test email from the backend.
# It is read-only and also requires the production Relay status to be healthy.
production-activation-check: production-config
	./scripts/production-compose.sh --profile activation run --rm --no-deps activation-check

# Direct-cutover installations can configure the three activation policies
# through the loopback Web API before the public reverse proxy is switched.
# The operator password is read from the terminal and is never an argument.
production-policy-bootstrap: production-config
	test -n "$(USERNAME)"
	test "$(CONFIRM_PEERGO_PRODUCTION_POLICIES)" = "APPLY_PEERGO_PRODUCTION_POLICIES"
	command -v python3 >/dev/null
	python3 ./scripts/bootstrap_production_policies.py \
		--env-file "$${PEERGO_PRODUCTION_ENV_FILE:-$(CURDIR)/.env.production}" \
		--username "$(USERNAME)" \
		--confirm "$(CONFIRM_PEERGO_PRODUCTION_POLICIES)"

# The first administrator is always an explicit existing account. Migration
# order, numeric ID or legacy level never grants site administration.
production-admin: production-config
	test -n "$(USERNAME)"
	./scripts/production-compose.sh \
		run --rm --no-deps --entrypoint core-admin core-api --username "$(USERNAME)"

production-admin-revoke: production-config
	test -n "$(USERNAME)"
	./scripts/production-compose.sh \
		run --rm --no-deps --entrypoint core-admin core-api --username "$(USERNAME)" --revoke

db-migrate:
	GOWORK=off go -C tools/migrator tool goose -dir ../../db/core/migrations postgres "$(CORE_DATABASE_URL)" up
	GOWORK=off go -C tools/migrator tool goose -dir ../../db/vault/migrations postgres "$(VAULT_DATABASE_URL)" up
	GOWORK=off go -C tools/migrator tool goose -dir ../../db/tracker/migrations postgres "$(TRACKER_DATABASE_URL)" up

db-status:
	GOWORK=off go -C tools/migrator tool goose -dir ../../db/core/migrations postgres "$(CORE_DATABASE_URL)" status
	GOWORK=off go -C tools/migrator tool goose -dir ../../db/vault/migrations postgres "$(VAULT_DATABASE_URL)" status
	GOWORK=off go -C tools/migrator tool goose -dir ../../db/tracker/migrations postgres "$(TRACKER_DATABASE_URL)" status

db-seed:
	docker compose -f deploy/compose/compose.yaml exec -T core-postgres psql -v ON_ERROR_STOP=1 -U peergo_core -d peergo_core -f /dev/stdin < db/core/seeds/development.sql
	PEERGO_ENV=development \
	PEERGO_CORE_DATABASE_URL="$(CORE_DATABASE_URL)" \
	PEERGO_AUDIT_PSEUDONYM_KEY="$(LOCAL_AUDIT_PSEUDONYM_KEY)" \
	PEERGO_AUDIT_PSEUDONYM_KEY_EPOCH="$(LOCAL_AUDIT_PSEUDONYM_KEY_EPOCH)" \
	PEERGO_TORRENT_STORAGE_BACKEND_ID="local-primary" \
	PEERGO_TORRENT_STORAGE_DRIVER="filesystem" \
	PEERGO_TORRENT_STORAGE_FILESYSTEM_ROOT="$(LOCAL_TORRENT_OBJECT_ROOT)" \
	go run ./services/core/cmd/devseed
	PEERGO_ENV=development \
	PEERGO_VAULT_DATABASE_URL="$(VAULT_DATABASE_URL)" \
	PEERGO_VAULT_IDENTIFIER_KEY="$(LOCAL_VAULT_IDENTIFIER_KEY)" \
	PEERGO_DEV_PASSWORD="$(DEMO_PASSWORD)" \
	go run ./services/privacy-vault/cmd/devseed
