# Preferred names. The legacy promotion-worker targets remain as aliases for
# existing local scripts. The process delivers independent policy outboxes and
# runs the bounded Core-owned assessment/enforcement loops.
dev-settlement-control-worker: dev-promotion-worker

dev-settlement-control-worker-watch: dev-promotion-worker-watch

# Reward settlement only receives the Core database credential.  It has no
