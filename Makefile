	PEERGO_ENV=development \
	PEERGO_CORE_DATABASE_URL="$(CORE_DATABASE_URL)" \
	PEERGO_SETTLEMENT_CONTROL_URL="$(LOCAL_SETTLEMENT_CONTROL_URL)" \
	PEERGO_SETTLEMENT_CONTROL_SERVICE_TOKEN="$(LOCAL_SETTLEMENT_CONTROL_SERVICE_TOKEN)" \
