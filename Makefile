# This target uses the local operator identity to create a missing Core durable
# consumer or reject drift. The Core projector runtime cannot manage it.
dev-core-traffic-consumer:
	PEERGO_ENV=development \
	PEERGO_CORE_TRAFFIC_NATS_URLS="$(LOCAL_TRACKER_NATS_URLS)" \
	PEERGO_CORE_TRAFFIC_NATS_PROVISION_CREDENTIALS_FILE="" \
	PEERGO_CORE_TRAFFIC_NATS_ROOT_CA_FILE="" \
	PEERGO_CORE_TRAFFIC_NATS_CONNECT_TIMEOUT="2s" \
	PEERGO_CORE_TRAFFIC_NATS_RECONNECT_WAIT="1s" \
	PEERGO_SETTLEMENT_TRAFFIC_STREAM="$(LOCAL_SETTLEMENT_TRAFFIC_STREAM)" \
	PEERGO_SETTLEMENT_TRAFFIC_SUBJECT="$(LOCAL_SETTLEMENT_TRAFFIC_SUBJECT)" \
	PEERGO_CORE_TRAFFIC_DURABLE="$(LOCAL_CORE_TRAFFIC_DURABLE)" \
	PEERGO_CORE_TRAFFIC_FETCH_WAIT="2s" \
	PEERGO_CORE_TRAFFIC_PROCESS_TIMEOUT="10s" \
