# Image processing is intentionally isolated from the general Core worker: it
# needs native libvips and object-storage credentials, while audit/outbox jobs
# do not. Both queues still appear in the same staff monitoring surface.
dev-image-derivative-worker:
	mkdir -p "$(LOCAL_IMAGE_DERIVATIVE_TEMP_ROOT)"
	PEERGO_ENV=development \
	PEERGO_CORE_DATABASE_URL="$(CORE_DATABASE_URL)" \
	PEERGO_TORRENT_STORAGE_BACKEND_ID="local-primary" \
	PEERGO_TORRENT_STORAGE_DRIVER="filesystem" \
	PEERGO_TORRENT_STORAGE_FILESYSTEM_ROOT="$(LOCAL_TORRENT_OBJECT_ROOT)" \
	PEERGO_IMAGE_DERIVATIVE_TEMP_DIR="$(LOCAL_IMAGE_DERIVATIVE_TEMP_ROOT)" \
	PEERGO_IMAGE_DERIVATIVE_VIPS_BINARY="vips" \
	go run ./services/core/cmd/image-derivative-worker

dev-image-derivative-worker-watch:
	mkdir -p "$(LOCAL_IMAGE_DERIVATIVE_TEMP_ROOT)"
	PEERGO_ENV=development \
	PEERGO_CORE_DATABASE_URL="$(CORE_DATABASE_URL)" \
	PEERGO_TORRENT_STORAGE_BACKEND_ID="local-primary" \
	PEERGO_TORRENT_STORAGE_DRIVER="filesystem" \
	PEERGO_TORRENT_STORAGE_FILESYSTEM_ROOT="$(LOCAL_TORRENT_OBJECT_ROOT)" \
	PEERGO_IMAGE_DERIVATIVE_TEMP_DIR="$(LOCAL_IMAGE_DERIVATIVE_TEMP_ROOT)" \
	PEERGO_IMAGE_DERIVATIVE_VIPS_BINARY="vips" \
	go -C tools/devtools tool air -c ../../.air/image-derivative-worker.toml

# Promotion/H&R/workgroup delivery and Core-owned ratio, newcomer and H&R
# evaluations share one supervised process. Each still keeps its own repository
# and failure state, so one control does not silently mutate another domain.
