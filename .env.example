# Production values must come from a secret manager. These names document the
# typed runtime contract; `make dev-*` supplies separate local-only fixtures.
PEERGO_ENV=production
# cluster is the fail-closed default. single-server only permits clear-text
# traffic to fixed service names on one private Docker network.
PEERGO_DEPLOYMENT_MODE=cluster
# Pin these tags or immutable digests for a real release. The cutover image is
# a one-shot operator tool and is never started by production-up.
PEERGO_RUNTIME_IMAGE=peergo/runtime:local
PEERGO_WEB_IMAGE=peergo/web:local
PEERGO_CUTOVER_IMAGE=peergo/cutover:local
# Optional host paths used by the single-server profile. Named-volume defaults
# remain available for cluster deployments.
PEERGO_OBJECTS_VOLUME_SOURCE=
PEERGO_TRACKER_VOLUME_SOURCE=
PEERGO_AUDIT_VOLUME_SOURCE=
PEERGO_IMAGE_DERIVATIVES_VOLUME_SOURCE=
PEERGO_SINGLE_SERVER_NETWORK=peergo-single
PEERGO_SINGLE_SERVER_NATS_IMAGE=nats:2.14.3-alpine3.22
PEERGO_SINGLE_SERVER_NATS_DATA_PATH=
PEERGO_SINGLE_SERVER_NATS_CONFIG_PATH=
# Host-only migration evidence root; restore-rousi-production.sh creates one
# immutable digest-named run directory below it.
PEERGO_PRODUCTION_CUTOVER_ROOT=
# Absolute directory containing NATS credentials and private CA files.
PEERGO_SECRET_DIR=
# Bind application HTTP ports to loopback; the operator-owned HTTPS proxy is
# the only public listener. Tracker metrics always remain loopback/private.
PEERGO_WEB_BIND_ADDRESS=127.0.0.1
PEERGO_WEB_HOST_PORT=8080
PEERGO_VAULT_HOST_PORT=8081
PEERGO_AUDIT_HOST_PORT=8082
PEERGO_TRACKER_BIND_ADDRESS=127.0.0.1
PEERGO_TRACKER_HOST_PORT=8083
PEERGO_TRACKER_METRICS_HOST_PORT=9093
# Comma-separated immediate reverse-proxy CIDRs. Tracker accepts exactly one
# proxy-overwritten X-Forwarded-For address only from these network peers.
PEERGO_TRACKER_TRUSTED_PROXY_CIDRS=
PEERGO_SETTLEMENT_CONTROL_HOST_PORT=8085
PEERGO_EMAIL_RELAY_HOST_PORT=8086
# Strict activation expectations. These are read-only checks and do not change
# site policies; adjust only when the intended launch policy is different.
PEERGO_PREFLIGHT_REGISTRATION_MODE=invite
PEERGO_PREFLIGHT_NEWCOMER_STATE=enabled
PEERGO_CORE_DATABASE_URL=
PEERGO_CORE_ADDR=0.0.0.0:8080
PEERGO_RATIO_WATCH_INTERVAL=1m
PEERGO_RATIO_WATCH_BATCH=500
PEERGO_VAULT_DATABASE_URL=
PEERGO_VAULT_ADDR=0.0.0.0:8081
# Independent Tracker Ledger database used only by Settlement and its future
# policy/outbox stages. Core does not receive this credential.
PEERGO_TRACKER_DATABASE_URL=
PEERGO_VAULT_URL=
PEERGO_VAULT_IDENTIFIER_KEY=
PEERGO_VAULT_TOTP_ENCRYPTION_KEY=
PEERGO_VAULT_TOTP_KEY_EPOCH=
PEERGO_VAULT_TRACKER_PASSKEY_ENCRYPTION_KEY=
PEERGO_VAULT_TRACKER_PASSKEY_KEY_EPOCH=
# Shared only by Vault (HMAC creation) and Tracker Edge (local request lookup).
# Core stores the resulting HMAC but does not receive this key.
PEERGO_TRACKER_PASSKEY_LOOKUP_KEY=
PEERGO_TRACKER_SERVICE_TOKEN=
PEERGO_VAULT_SERVICE_TOKEN=
PEERGO_EMAIL_VERIFICATION_PUBLIC_URL=https://peergo.example/verify-email
PEERGO_PASSWORD_RECOVERY_PUBLIC_URL=https://peergo.example/reset-password
PEERGO_EMAIL_DELIVERY_URL=
PEERGO_EMAIL_DELIVERY_SERVICE_TOKEN=
# Email Relay only. Keep SMTP credentials out of Core, Web and public status
# responses. `starttls` is the normal choice for port 587; `implicit` is for 465.
PEERGO_EMAIL_RELAY_ADDR=0.0.0.0:8086
PEERGO_EMAIL_RELAY_SERVICE_TOKEN=
PEERGO_EMAIL_SITE_NAME=PeerGo
PEERGO_SMTP_HOST=smtp.example.com
PEERGO_SMTP_PORT=587
PEERGO_SMTP_USERNAME=
PEERGO_SMTP_PASSWORD=
PEERGO_SMTP_FROM_ADDRESS=noreply@peergo.example
PEERGO_SMTP_FROM_NAME=PeerGo
PEERGO_SMTP_TLS_MODE=starttls
PEERGO_SMTP_TIMEOUT=10s
PEERGO_SESSION_CSRF_KEY=
PEERGO_WEBAUTHN_RP_ID=peergo.example
PEERGO_WEBAUTHN_ORIGINS=https://peergo.example
PEERGO_WEBAUTHN_RECORD_KEY=
PEERGO_WEBAUTHN_KEY_EPOCH=
PEERGO_AUDIT_PSEUDONYM_KEY=
PEERGO_AUDIT_PSEUDONYM_KEY_EPOCH=
PEERGO_AUDIT_SINK_URL=
PEERGO_AUDIT_ADDR=0.0.0.0:8082
PEERGO_AUDIT_JOURNAL_PATH=/var/lib/peergo/audit/events.jsonl
PEERGO_AUDIT_SERVICE_TOKEN=
PEERGO_SETTLEMENT_CONTROL_URL=
PEERGO_SETTLEMENT_CONTROL_ADDR=0.0.0.0:8085
PEERGO_SETTLEMENT_CONTROL_SERVICE_TOKEN=
PEERGO_COOKIE_SECURE=true
PEERGO_WEB_ORIGINS=https://peergo.example
PEERGO_PUBLIC_ORIGIN=https://peergo.example
# Core only. The public Turnstile site key and protected pages are versioned in
# “设置 / 注册设置”; this server-side secret must come from the secret manager.
PEERGO_TURNSTILE_SECRET_KEY=

# Core snapshot-builder only: the private key accepts a standard-Base64
# 32-byte Ed25519 seed or a self-consistent 64-byte private key. The output is
# currently a service-owned local file published by atomic rename.
PEERGO_TRACKER_SNAPSHOT_KEY_ID=
PEERGO_TRACKER_SNAPSHOT_SIGNING_KEY_BASE64=
PEERGO_TRACKER_SNAPSHOT_PATH=/var/lib/peergo/tracker/control.snapshot
PEERGO_TRACKER_SUBJECT_SNAPSHOT_PATH=/var/lib/peergo/tracker/subjects.snapshot
PEERGO_TRACKER_RUNTIME_POLICY_SNAPSHOT_PATH=/var/lib/peergo/tracker/runtime-policy.snapshot
# Empty keeps cutover jobs one-shot; a supervised publisher should use a value
# shorter than PEERGO_TRACKER_SUBJECT_SNAPSHOT_MAX_AGE (for example 30s).
PEERGO_TRACKER_SNAPSHOT_PUBLISH_INTERVAL=

# Tracker only: comma-separated key_id=standard-base64 public keys permit an
# overlap window during key rotation. Never inject Core's private key here.
PEERGO_TRACKER_SNAPSHOT_TRUSTED_KEYS=
PEERGO_TRACKER_SNAPSHOT_MAX_AGE=15m
PEERGO_TRACKER_SUBJECT_SNAPSHOT_MAX_AGE=1m
PEERGO_TRACKER_RUNTIME_POLICY_SNAPSHOT_MAX_AGE=15m
PEERGO_TRACKER_SNAPSHOT_MAX_FUTURE_SKEW=2m
PEERGO_TRACKER_LISTEN_ADDRESS=0.0.0.0:8083
# Bind this to a private monitoring network; do not expose it through the
# public Tracker ingress.
PEERGO_TRACKER_METRICS_LISTEN_ADDRESS=0.0.0.0:9093
PEERGO_TRACKER_SNAPSHOT_RELOAD_INTERVAL=5s
PEERGO_TRACKER_SHUTDOWN_TIMEOUT=10s
PEERGO_TRACKER_ANNOUNCE_INTERVAL_SECONDS=1800
PEERGO_TRACKER_MIN_ANNOUNCE_INTERVAL_SECONDS=900
PEERGO_TRACKER_DEFAULT_NUMWANT=50
PEERGO_TRACKER_MAX_NUMWANT=100
PEERGO_TRACKER_SWARM_SHARDS=64
PEERGO_TRACKER_MAX_SWARMS=1000000
PEERGO_TRACKER_MAX_PEERS=10000000
PEERGO_TRACKER_MAX_PEERS_PER_SWARM=100000
PEERGO_TRACKER_PEER_TTL=35m
PEERGO_TRACKER_SWEEP_BUDGET=64
PEERGO_TRACKER_WAL_PATH=/var/lib/peergo/tracker/announce.wal
PEERGO_TRACKER_WAL_MAX_BYTES=10737418240
PEERGO_TRACKER_WAL_COMPACT_AT_BYTES=67108864
# Tracker runtime credentials are publish-only. URLs never contain credentials;
# cluster production requires tls:// and mounted NATS credentials. The explicit
# single-server bootstrap substitutes one fixed private nats:// service name.
PEERGO_TRACKER_NATS_URLS=tls://nats-1.internal:4222,tls://nats-2.internal:4222,tls://nats-3.internal:4222
PEERGO_TRACKER_NATS_CREDENTIALS_FILE=/run/secrets/peergo-tracker-nats.creds
PEERGO_TRACKER_NATS_ROOT_CA_FILE=/run/secrets/peergo-nats-root-ca.pem
PEERGO_TRACKER_NATS_CONNECT_TIMEOUT=5s
PEERGO_TRACKER_NATS_RECONNECT_WAIT=1s
PEERGO_TRACKER_ANNOUNCE_STREAM=PEERGO_TRACKER_ANNOUNCE_V1
PEERGO_TRACKER_ANNOUNCE_SUBJECT=peergo.tracker.announce.v1
PEERGO_TRACKER_ANNOUNCE_PUBLISH_TIMEOUT=5s
PEERGO_TRACKER_ANNOUNCE_PUBLISH_RETRY_MIN=100ms
PEERGO_TRACKER_ANNOUNCE_PUBLISH_RETRY_MAX=30s
# cmd/jetstream-init only; never inject this management identity into Tracker.
PEERGO_TRACKER_NATS_PROVISION_CREDENTIALS_FILE=/run/secrets/peergo-nats-provisioner.creds
PEERGO_TRACKER_ANNOUNCE_STREAM_PROVISION_TIMEOUT=30s
PEERGO_TRACKER_ANNOUNCE_STREAM_MAX_BYTES=53687091200
PEERGO_TRACKER_ANNOUNCE_STREAM_MAX_AGE=168h
PEERGO_TRACKER_ANNOUNCE_STREAM_DUPLICATE_WINDOW=10m
PEERGO_TRACKER_ANNOUNCE_STREAM_REPLICAS=3
PEERGO_TRACKER_SWARM_SWEEP_INTERVAL=30s
PEERGO_TRACKER_SWARM_SWEEP_SWARM_BUDGET=10000
# One complete single-engine scope. source_id is stable for the state file;
# routing_epoch is advanced explicitly when ownership/routing changes.
PEERGO_TRACKER_SWARM_SNAPSHOT_STREAM=PEERGO_TRACKER_SWARM_SNAPSHOT_V1
PEERGO_TRACKER_SWARM_SNAPSHOT_SUBJECT=peergo.tracker.swarm.snapshot.v1
PEERGO_TRACKER_SWARM_SNAPSHOT_SOURCE_ID=tracker-primary
PEERGO_TRACKER_SWARM_ROUTING_EPOCH=1
PEERGO_TRACKER_SWARM_SEQUENCE_PATH=/var/lib/peergo/tracker/swarm-sequence.json
PEERGO_TRACKER_SWARM_SNAPSHOT_INTERVAL=30s
PEERGO_TRACKER_SWARM_SNAPSHOT_MAX_CHUNK_ENTRIES=2000
# cmd/swarm-stream-init only. Snapshot retention is replaceable; the announce
# evidence stream above remains independent and uses its own retention policy.
PEERGO_TRACKER_SWARM_STREAM_PROVISION_TIMEOUT=30s
PEERGO_TRACKER_SWARM_STREAM_MAX_BYTES=10737418240
PEERGO_TRACKER_SWARM_STREAM_MAX_AGE=24h
PEERGO_TRACKER_SWARM_STREAM_DUPLICATE_WINDOW=10m
PEERGO_TRACKER_SWARM_STREAM_REPLICAS=3

# Settlement raw-ingest runtime credentials can inspect/pull from the one
# Tracker announce durable consumer and send ACKs, but cannot manage it.
PEERGO_SETTLEMENT_NATS_URLS=tls://nats-1.internal:4222,tls://nats-2.internal:4222,tls://nats-3.internal:4222
PEERGO_SETTLEMENT_NATS_CREDENTIALS_FILE=/run/secrets/peergo-settlement-nats.creds
PEERGO_SETTLEMENT_NATS_ROOT_CA_FILE=/run/secrets/peergo-nats-root-ca.pem
PEERGO_SETTLEMENT_NATS_CONNECT_TIMEOUT=5s
PEERGO_SETTLEMENT_NATS_RECONNECT_WAIT=1s
PEERGO_SETTLEMENT_ANNOUNCE_DURABLE=PEERGO_SETTLEMENT_V1
PEERGO_SETTLEMENT_FETCH_WAIT=2s
PEERGO_SETTLEMENT_PROCESS_TIMEOUT=10s
PEERGO_SETTLEMENT_ACK_TIMEOUT=5s
PEERGO_SETTLEMENT_RETRY_DELAY=1s
PEERGO_SETTLEMENT_STARTUP_TIMEOUT=15s
PEERGO_SETTLEMENT_SHUTDOWN_TIMEOUT=10s
# cmd/consumer-init only; never inject this management identity into runtime.
PEERGO_SETTLEMENT_NATS_PROVISION_CREDENTIALS_FILE=/run/secrets/peergo-nats-provisioner.creds
PEERGO_SETTLEMENT_CONSUMER_PROVISION_TIMEOUT=30s
PEERGO_SETTLEMENT_CONSUMER_ACK_WAIT=30s
PEERGO_SETTLEMENT_CONSUMER_MAX_WAITING=16
PEERGO_SETTLEMENT_CONSUMER_MAX_REQUEST_EXPIRES=5s

# Settlement consumes the same canonical full-swarm snapshot stream through a
# separate durable and retains complete historical entries for hourly evidence.
# Runtime credentials may pull/ACK only; the provisioner identity creates the
# durable and is never injected into the projector.
PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_DURABLE=PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_V1
PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_FETCH_WAIT=2s
PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_PROCESS_TIMEOUT=10s
PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_ACK_TIMEOUT=5s
PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_RETRY_DELAY=1s
PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_STARTUP_TIMEOUT=15s
PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_SHUTDOWN_TIMEOUT=10s
PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_MAX_FUTURE_SKEW=2m
PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_MAX_CLOSURE_DELAY=15m
PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_PROVISION_TIMEOUT=30s
PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_ACK_WAIT=30s
PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_MAX_WAITING=16
PEERGO_SETTLEMENT_SEEDING_SNAPSHOT_MAX_REQUEST_EXPIRES=5s

# Set this once to PeerGo's exact UTC traffic-accounting cutover hour. The
# evidence worker never back-calculates pre-cutover PtYes activity.
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_START_AT=
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_CLOSURE_DELAY=5m
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_IDLE_INTERVAL=5s
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_STARTUP_TIMEOUT=15s
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_SHUTDOWN_TIMEOUT=10s

# Each closed hour writes these canonical chunks in the same Tracker Ledger
# transaction as its evidence. Publisher credentials cannot manage the stream.
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_STREAM=PEERGO_SETTLEMENT_SEEDING_EVIDENCE_V1
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_SUBJECT=peergo.settlement.seeding.evidence.v1
PEERGO_SETTLEMENT_NATS_SEEDING_EVIDENCE_PUBLISH_CREDENTIALS_FILE=/run/secrets/peergo-settlement-seeding-evidence-publisher.creds
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_OUTBOX_LEASE_DURATION=30s
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_OUTBOX_IDLE_INTERVAL=500ms
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_OUTBOX_RETRY_BASE=1s
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_PUBLISH_TIMEOUT=5s
# cmd/seeding-evidence-stream-init only; existing drift fails closed.
PEERGO_SETTLEMENT_NATS_SEEDING_EVIDENCE_PROVISION_CREDENTIALS_FILE=/run/secrets/peergo-settlement-seeding-evidence-provisioner.creds
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_STREAM_PROVISION_TIMEOUT=30s
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_STREAM_MAX_BYTES=53687091200
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_STREAM_MAX_AGE=720h
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_STREAM_DUPLICATE_WINDOW=10m
PEERGO_SETTLEMENT_SEEDING_EVIDENCE_STREAM_REPLICAS=3

# Final policy settlement is a Tracker Ledger-only process. The operator
# appends complete canonical snapshots to the immutable policy timeline before
# any matching raw interval can settle; there is no implicit/current 1x rule.
PEERGO_SETTLEMENT_POLICY_LEASE_DURATION=30s
PEERGO_SETTLEMENT_POLICY_IDLE_INTERVAL=500ms
PEERGO_SETTLEMENT_POLICY_RETRY_BASE=1s
PEERGO_SETTLEMENT_POLICY_STARTUP_TIMEOUT=15s

# Final Settlement traffic events use a dedicated JetStream stream. Dispatcher
# credentials can publish with a stable event ID but cannot manage the stream.
PEERGO_SETTLEMENT_TRAFFIC_STREAM=PEERGO_SETTLEMENT_TRAFFIC_V1
PEERGO_SETTLEMENT_TRAFFIC_SUBJECT=peergo.settlement.traffic.v1
PEERGO_SETTLEMENT_NATS_PUBLISH_CREDENTIALS_FILE=/run/secrets/peergo-settlement-traffic-publisher.creds
PEERGO_SETTLEMENT_TRAFFIC_OUTBOX_LEASE_DURATION=30s
PEERGO_SETTLEMENT_TRAFFIC_OUTBOX_IDLE_INTERVAL=500ms
PEERGO_SETTLEMENT_TRAFFIC_OUTBOX_RETRY_BASE=1s
PEERGO_SETTLEMENT_TRAFFIC_PUBLISH_TIMEOUT=5s
PEERGO_SETTLEMENT_TRAFFIC_STARTUP_TIMEOUT=15s
PEERGO_SETTLEMENT_TRAFFIC_SHUTDOWN_TIMEOUT=10s
# cmd/traffic-stream-init only; existing stream configuration drift fails.
PEERGO_SETTLEMENT_NATS_TRAFFIC_PROVISION_CREDENTIALS_FILE=/run/secrets/peergo-settlement-traffic-provisioner.creds
PEERGO_SETTLEMENT_TRAFFIC_STREAM_PROVISION_TIMEOUT=30s
PEERGO_SETTLEMENT_TRAFFIC_STREAM_MAX_BYTES=53687091200
PEERGO_SETTLEMENT_TRAFFIC_STREAM_MAX_AGE=720h
PEERGO_SETTLEMENT_TRAFFIC_STREAM_DUPLICATE_WINDOW=10m
PEERGO_SETTLEMENT_TRAFFIC_STREAM_REPLICAS=3

# H&R assessment output is isolated from traffic settlement and reward
# evidence. The policy worker writes immutable obligations, then this stream
# delivers only the resulting user projection to Core.
PEERGO_SETTLEMENT_HNR_STREAM=PEERGO_SETTLEMENT_HNR_V1
PEERGO_SETTLEMENT_HNR_SUBJECT=peergo.settlement.hnr.v1
PEERGO_SETTLEMENT_HNR_LEASE_DURATION=30s
PEERGO_SETTLEMENT_HNR_IDLE_INTERVAL=500ms
PEERGO_SETTLEMENT_HNR_RETRY_BASE=1s
PEERGO_SETTLEMENT_HNR_STARTUP_TIMEOUT=15s
PEERGO_SETTLEMENT_NATS_HNR_PUBLISH_CREDENTIALS_FILE=/run/secrets/peergo-settlement-hnr-publisher.creds
PEERGO_SETTLEMENT_HNR_OUTBOX_LEASE_DURATION=30s
PEERGO_SETTLEMENT_HNR_OUTBOX_IDLE_INTERVAL=500ms
PEERGO_SETTLEMENT_HNR_OUTBOX_RETRY_BASE=1s
PEERGO_SETTLEMENT_HNR_PUBLISH_TIMEOUT=5s
PEERGO_SETTLEMENT_HNR_SHUTDOWN_TIMEOUT=10s
PEERGO_SETTLEMENT_NATS_HNR_PROVISION_CREDENTIALS_FILE=/run/secrets/peergo-settlement-hnr-provisioner.creds
PEERGO_SETTLEMENT_HNR_STREAM_PROVISION_TIMEOUT=30s
PEERGO_SETTLEMENT_HNR_STREAM_MAX_BYTES=53687091200
PEERGO_SETTLEMENT_HNR_STREAM_MAX_AGE=720h
PEERGO_SETTLEMENT_HNR_STREAM_DUPLICATE_WINDOW=10m
PEERGO_SETTLEMENT_HNR_STREAM_REPLICAS=3

# Core's traffic projector reads only final Settlement events. It owns its
# idempotent inbox/read models, never a Tracker Ledger connection. Runtime and
# provisioning identities remain separate from each other and from Settlement.
PEERGO_CORE_TRAFFIC_NATS_URLS=tls://nats-1.internal:4222,tls://nats-2.internal:4222,tls://nats-3.internal:4222
PEERGO_CORE_TRAFFIC_NATS_CREDENTIALS_FILE=/run/secrets/peergo-core-traffic-consumer.creds
PEERGO_CORE_TRAFFIC_NATS_ROOT_CA_FILE=/run/secrets/peergo-nats-root-ca.pem
PEERGO_CORE_TRAFFIC_NATS_CONNECT_TIMEOUT=5s
PEERGO_CORE_TRAFFIC_NATS_RECONNECT_WAIT=1s
PEERGO_CORE_TRAFFIC_DURABLE=PEERGO_CORE_TRAFFIC_V1
PEERGO_CORE_TRAFFIC_FETCH_WAIT=2s
PEERGO_CORE_TRAFFIC_PROCESS_TIMEOUT=10s
PEERGO_CORE_TRAFFIC_ACK_TIMEOUT=5s
PEERGO_CORE_TRAFFIC_RETRY_DELAY=1s
PEERGO_CORE_TRAFFIC_STARTUP_TIMEOUT=15s
PEERGO_CORE_TRAFFIC_SHUTDOWN_TIMEOUT=10s
# cmd/traffic-consumer-init only; this identity can create/inspect the durable.
PEERGO_CORE_TRAFFIC_NATS_PROVISION_CREDENTIALS_FILE=/run/secrets/peergo-core-traffic-provisioner.creds
PEERGO_CORE_TRAFFIC_CONSUMER_PROVISION_TIMEOUT=30s
PEERGO_CORE_TRAFFIC_CONSUMER_ACK_WAIT=30s
PEERGO_CORE_TRAFFIC_CONSUMER_MAX_WAITING=16
PEERGO_CORE_TRAFFIC_CONSUMER_MAX_REQUEST_EXPIRES=5s

# Core H&R projection credentials can consume and ACK only the H&R result
# durable. Provisioning uses a separate operator identity.
PEERGO_CORE_HNR_NATS_URLS=tls://nats-1.internal:4222,tls://nats-2.internal:4222,tls://nats-3.internal:4222
PEERGO_CORE_HNR_NATS_CREDENTIALS_FILE=/run/secrets/peergo-core-hnr-consumer.creds
PEERGO_CORE_HNR_NATS_ROOT_CA_FILE=/run/secrets/peergo-nats-root-ca.pem
PEERGO_CORE_HNR_NATS_CONNECT_TIMEOUT=5s
PEERGO_CORE_HNR_NATS_RECONNECT_WAIT=1s
PEERGO_CORE_HNR_DURABLE=PEERGO_CORE_HNR_V1
PEERGO_CORE_HNR_FETCH_WAIT=2s
PEERGO_CORE_HNR_PROCESS_TIMEOUT=10s
PEERGO_CORE_HNR_ACK_TIMEOUT=5s
PEERGO_CORE_HNR_RETRY_DELAY=1s
PEERGO_CORE_HNR_STARTUP_TIMEOUT=15s
PEERGO_CORE_HNR_SHUTDOWN_TIMEOUT=10s
PEERGO_CORE_HNR_NATS_PROVISION_CREDENTIALS_FILE=/run/secrets/peergo-core-hnr-provisioner.creds
PEERGO_CORE_HNR_CONSUMER_PROVISION_TIMEOUT=30s
PEERGO_CORE_HNR_CONSUMER_ACK_WAIT=30s
PEERGO_CORE_HNR_CONSUMER_MAX_WAITING=16
PEERGO_CORE_HNR_CONSUMER_MAX_REQUEST_EXPIRES=5s

# Core receives the privacy-minimized closed evidence through an independent
# durable. It marks a window complete only after item count and projection
# SHA-256 agree; neither process has a Tracker Ledger database credential.
PEERGO_CORE_SEEDING_EVIDENCE_NATS_URLS=tls://nats-1.internal:4222,tls://nats-2.internal:4222,tls://nats-3.internal:4222
PEERGO_CORE_SEEDING_EVIDENCE_NATS_CREDENTIALS_FILE=/run/secrets/peergo-core-seeding-evidence-consumer.creds
PEERGO_CORE_SEEDING_EVIDENCE_NATS_ROOT_CA_FILE=/run/secrets/peergo-nats-root-ca.pem
PEERGO_CORE_SEEDING_EVIDENCE_NATS_CONNECT_TIMEOUT=5s
PEERGO_CORE_SEEDING_EVIDENCE_NATS_RECONNECT_WAIT=1s
PEERGO_CORE_SEEDING_EVIDENCE_DURABLE=PEERGO_CORE_SEEDING_EVIDENCE_V1
PEERGO_CORE_SEEDING_EVIDENCE_FETCH_WAIT=2s
PEERGO_CORE_SEEDING_EVIDENCE_PROCESS_TIMEOUT=10s
PEERGO_CORE_SEEDING_EVIDENCE_ACK_TIMEOUT=5s
PEERGO_CORE_SEEDING_EVIDENCE_RETRY_DELAY=1s
PEERGO_CORE_SEEDING_EVIDENCE_STARTUP_TIMEOUT=15s
PEERGO_CORE_SEEDING_EVIDENCE_SHUTDOWN_TIMEOUT=10s
PEERGO_CORE_SEEDING_EVIDENCE_MAX_FUTURE_SKEW=2m
PEERGO_CORE_SEEDING_EVIDENCE_NATS_PROVISION_CREDENTIALS_FILE=/run/secrets/peergo-core-seeding-evidence-provisioner.creds
PEERGO_CORE_SEEDING_EVIDENCE_CONSUMER_PROVISION_TIMEOUT=30s
PEERGO_CORE_SEEDING_EVIDENCE_CONSUMER_ACK_WAIT=30s
PEERGO_CORE_SEEDING_EVIDENCE_CONSUMER_MAX_WAITING=16
PEERGO_CORE_SEEDING_EVIDENCE_CONSUMER_MAX_REQUEST_EXPIRES=5s

# Core's swarm projector reads complete active-count snapshots and the existing
# announce stream through two independent ordered durable consumers. Runtime
# credentials can consume/ACK both streams but cannot manage either consumer.
PEERGO_CORE_SWARM_NATS_URLS=tls://nats-1.internal:4222,tls://nats-2.internal:4222,tls://nats-3.internal:4222
PEERGO_CORE_SWARM_NATS_CREDENTIALS_FILE=/run/secrets/peergo-core-swarm-consumer.creds
PEERGO_CORE_SWARM_NATS_ROOT_CA_FILE=/run/secrets/peergo-nats-root-ca.pem
PEERGO_CORE_SWARM_NATS_CONNECT_TIMEOUT=5s
PEERGO_CORE_SWARM_NATS_RECONNECT_WAIT=1s
PEERGO_CORE_SWARM_SNAPSHOT_DURABLE=PEERGO_CORE_SWARM_SNAPSHOT_V1
PEERGO_CORE_SWARM_COMPLETION_DURABLE=PEERGO_CORE_SWARM_COMPLETION_V1
PEERGO_CORE_SWARM_FETCH_WAIT=2s
PEERGO_CORE_SWARM_PROCESS_TIMEOUT=10s
PEERGO_CORE_SWARM_ACK_TIMEOUT=5s
PEERGO_CORE_SWARM_RETRY_DELAY=1s
PEERGO_CORE_SWARM_STARTUP_TIMEOUT=15s
PEERGO_CORE_SWARM_SHUTDOWN_TIMEOUT=10s
PEERGO_CORE_SWARM_MAX_FUTURE_SKEW=2m
# cmd/swarm-consumer-init only; this identity can create/inspect both durables.
PEERGO_CORE_SWARM_NATS_PROVISION_CREDENTIALS_FILE=/run/secrets/peergo-core-swarm-provisioner.creds
PEERGO_CORE_SWARM_CONSUMER_PROVISION_TIMEOUT=30s
PEERGO_CORE_SWARM_CONSUMER_ACK_WAIT=30s
PEERGO_CORE_SWARM_CONSUMER_MAX_WAITING=16
PEERGO_CORE_SWARM_CONSUMER_MAX_REQUEST_EXPIRES=5s

# Core API download-copy builder. This must be the stable public Tracker origin,
# never a Pod/node/preview hostname; Core appends /tracker/{passkey}/announce.
PEERGO_TRACKER_CANONICAL_ORIGIN=https://tracker.example
# Core reads Tracker's authenticated runtime view over this private origin.
# Single-server production uses the fixed Docker service origin below.
PEERGO_TRACKER_OPERATIONS_ORIGIN=http://tracker:8083

# Finite PtYes migration commands only. The restore URL uses the isolated
# source owner; the source URL uses a separate read-only role and must never
# equal a PeerGo target URL. The snapshot digest,
# run UUID and occurred-at timestamp are frozen for the whole rehearsal; the
# immutable asset inputs are either separate torrents.zip + uploads.zip files,
# or one combined assets.zip containing both torrent objects and
# uploads/images. Torrent gallery/poster images migrate; avatars and unrelated
# uploads remain outside the migration boundary.
# User migration additionally requires the Vault keys already declared above
# plus an independent high-entropy fingerprint key.
PEERGO_LEGACY_DUMP_PATH=
# restore command only; must identify an explicitly prepared empty source DB.
PEERGO_LEGACY_RESTORE_DATABASE_URL=
PEERGO_LEGACY_SOURCE_DATABASE_URL=
PEERGO_LEGACY_RUN_ID=
PEERGO_LEGACY_SNAPSHOT_SHA256=
PEERGO_LEGACY_MAPPING_VERSION=ptyes-v1
PEERGO_LEGACY_OCCURRED_AT=
PEERGO_LEGACY_RECONCILED_AT=
# Absolute PtYes torrent_dir or a strict ZIP snapshot of that directory.
PEERGO_LEGACY_TORRENT_ROOT=
# Absolute uploads.zip, or the same combined assets.zip path used above.
PEERGO_LEGACY_IMAGE_ROOT=
# Computed by scripts/migrate-ptyes.sh; set only to pin an expected digest.
PEERGO_LEGACY_IMAGE_ARCHIVE_SHA256=
# Independent derivative worker. The source importer retains exact originals;
# this private directory is used only while libvips creates replaceable WebP.
PEERGO_IMAGE_DERIVATIVE_TEMP_DIR=/var/lib/peergo/image-derivative-tmp
PEERGO_IMAGE_DERIVATIVE_VIPS_BINARY=vips
PEERGO_IMAGE_DERIVATIVE_POLL_INTERVAL=2s
PEERGO_IMAGE_DERIVATIVE_LEASE_DURATION=5m
# Cooperating image processors used only by the finite migration drain. Each
# processor receives a proportional libvips thread budget; supported range is
# 1-16 and 4 is the conservative single-server default.
PEERGO_IMAGE_DERIVATIVE_CONCURRENCY=4
# Optional absolute snapshot-bound TSV. Default is empty/fail-closed; it may
# explicitly skip only SQL rows whose immutable object is physically missing.
PEERGO_LEGACY_TORRENT_EXCLUSIONS=
# Candidate generation only; target must not already exist.
PEERGO_LEGACY_TORRENT_EXCLUSIONS_OUTPUT=
PEERGO_LEGACY_PROGRESS_EVERY=250
PEERGO_LEGACY_FINGERPRINT_KEY=

# Core API active write backend for original `.torrent` objects. The backend
# ID is stable database identity; endpoint paths and credentials remain runtime
# configuration. The upload limit cannot exceed the 16 MiB parser ceiling.
PEERGO_TORRENT_STORAGE_BACKEND_ID=local-primary
PEERGO_TORRENT_STORAGE_DRIVER=filesystem
PEERGO_TORRENT_STORAGE_FILESYSTEM_ROOT=/var/lib/peergo/objects
PEERGO_TORRENT_STORAGE_S3_REGION=
PEERGO_TORRENT_STORAGE_S3_BUCKET=
PEERGO_TORRENT_STORAGE_S3_PREFIX=
PEERGO_TORRENT_STORAGE_S3_ENDPOINT=
PEERGO_TORRENT_STORAGE_S3_USE_PATH_STYLE=false
PEERGO_TORRENT_STORAGE_S3_CREDENTIALS_MODE=default
PEERGO_TORRENT_STORAGE_S3_ACCESS_KEY_ID=
PEERGO_TORRENT_STORAGE_S3_SECRET_ACCESS_KEY=
PEERGO_TORRENT_STORAGE_S3_SESSION_TOKEN=
PEERGO_TORRENT_UPLOAD_MAX_BYTES=4194304

# `cmd/torrent-storage` only. The Core API does not read migration credentials,
# and database rows store only stable backend IDs plus provider-neutral keys.
# Either side may use `filesystem` or `s3`; unused driver fields stay empty.
PEERGO_STORAGE_SOURCE_BACKEND_ID=
PEERGO_STORAGE_SOURCE_DRIVER=filesystem
PEERGO_STORAGE_SOURCE_FILESYSTEM_ROOT=
PEERGO_STORAGE_SOURCE_S3_REGION=
PEERGO_STORAGE_SOURCE_S3_BUCKET=
PEERGO_STORAGE_SOURCE_S3_PREFIX=
PEERGO_STORAGE_SOURCE_S3_ENDPOINT=
PEERGO_STORAGE_SOURCE_S3_USE_PATH_STYLE=false
PEERGO_STORAGE_SOURCE_S3_CREDENTIALS_MODE=default
PEERGO_STORAGE_SOURCE_S3_ACCESS_KEY_ID=
PEERGO_STORAGE_SOURCE_S3_SECRET_ACCESS_KEY=
PEERGO_STORAGE_SOURCE_S3_SESSION_TOKEN=
PEERGO_STORAGE_DESTINATION_BACKEND_ID=
PEERGO_STORAGE_DESTINATION_DRIVER=s3
PEERGO_STORAGE_DESTINATION_FILESYSTEM_ROOT=
PEERGO_STORAGE_DESTINATION_S3_REGION=
PEERGO_STORAGE_DESTINATION_S3_BUCKET=
PEERGO_STORAGE_DESTINATION_S3_PREFIX=
PEERGO_STORAGE_DESTINATION_S3_ENDPOINT=
PEERGO_STORAGE_DESTINATION_S3_USE_PATH_STYLE=false
PEERGO_STORAGE_DESTINATION_S3_CREDENTIALS_MODE=default
PEERGO_STORAGE_DESTINATION_S3_ACCESS_KEY_ID=
PEERGO_STORAGE_DESTINATION_S3_SECRET_ACCESS_KEY=
PEERGO_STORAGE_DESTINATION_S3_SESSION_TOKEN=
